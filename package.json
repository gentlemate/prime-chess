{
    "name": "prime-chess",
    "version": "1.0.0",
    "description": "",
    "workspaces": [
        "apps/*",
        "packages/*"
    ],
    "scripts": {
        "dev:frontend": "pnpm --filter @primechess/frontend dev",
        "dev:backend": "pnpm --filter @primechess/backend dev",
        "dev": "pnpm -r dev",
        "test:chess-lib": "pnpm --filter @primechess/chess-lib exec vitest run",
        "build:chess-lib": "pnpm --filter @primechess/chess-lib build",
        "chess-lib": "pnpm test:chess-lib && pnpm build:chess-lib",
        "update": "pnpm -r update",
        "update:frontend": "pnpm update --filter @primechess/frontend",
        "update:backend": "pnpm update --filter @primechess/backend",
        "format": "prettier --write .",
        "format:check": "prettier --check ."
    },
    "keywords": [],
    "author": "gentlemate",
    "packageManager": "pnpm@10.34.9",
    "devDependencies": {
        "prettier": "^3.10.1",
        "prettier-plugin-tailwindcss": "^0.8.1"
    }
}
